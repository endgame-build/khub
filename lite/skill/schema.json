{
  "version": "0.1.0",
  "provenance": "khub build-lite preset 0.1.0",
  "base": {
    "attributes": {
      "type": { "type": "text", "required": true },
      "title": { "type": "text", "required": true },
      "created": { "type": "date", "required": true },
      "updated": { "type": "date" },
      "description": { "type": "text" },
      "resource": { "type": "text" },
      "tags": { "type": "list" }
    },
    "relations": {
      "related": { "to": "any", "many": true },
      "depends_on": { "to": "any", "many": true, "acyclic": true }
    }
  },
  "types": {
    "prd": {
      "path": "knowledge/prd.md",
      "singleton": true,
      "required": true,
      "orphan": true
    },
    "arc42": {
      "path": "knowledge/arc42.md",
      "singleton": true,
      "orphan": true
    },
    "requirement": {
      "path": "knowledge/requirements",
      "id_prefix": { "by": "kind", "map": { "functional": "fr", "constraint": "cst", "business-rule": "br" } },
      "attributes": {
        "kind": { "enum": ["functional", "constraint", "business-rule"], "required": true }
      },
      "relations": {
        "realized_in": { "to": "component", "many": true }
      }
    },
    "adr": {
      "path": "knowledge/decisions",
      "id_prefix": "ad",
      "attributes": {
        "status": { "enum": ["proposed", "accepted", "rejected"], "required": true }
      },
      "relations": {
        "supersedes": { "to": "adr", "inverse": "superseded", "acyclic": true },
        "affects": { "to": "any", "many": true }
      }
    },
    "component": {
      "path": "knowledge/components",
      "id_prefix": "cmp",
      "attributes": {
        "kind": { "enum": ["service", "library", "external"], "required": true },
        "stack": { "type": "text" },
        "repo": { "type": "text" }
      }
    },
    "feature-spec": {
      "path": "specs",
      "id_prefix": "fs",
      "attributes": {
        "status": { "enum": ["planned", "active", "done", "dropped"], "required": true }
      },
      "relations": {
        "requirements": { "to": "requirement", "many": true },
        "supersedes": { "to": "feature-spec", "inverse": "superseded", "acyclic": true }
      }
    }
  }
}
