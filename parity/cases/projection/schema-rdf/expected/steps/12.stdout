        khub:type "text"
    ] ;
    sh:property [
        sh:path field:role ;
        sh:name "role" ;
        sh:order 10 ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "consultant" "engineer" "manager" "partner" ) ;
        khub:type "text"
    ] ;
    sh:property [
        sh:path field:department ;
        sh:name "department" ;
        sh:order 11 ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:in ( "engineering" "consulting" "delivery-management" "people" "sales" ) ;
        khub:type "text"
    ] ;
    sh:property [
        sh:path khub:related ;
        sh:name "related" ;
        sh:order 12 ;
        sh:nodeKind sh:IRI ;
        sh:class khub:Entity ;
        khub:kind "any"
    ] ;
    sh:property [
        sh:path khub:sources ;
        sh:name "sources" ;
        sh:order 13 ;
        sh:nodeKind sh:IRI ;
        sh:class khub:Entity ;
        khub:kind "any"
    ] ;
    sh:property [
        sh:path khub:references ;
        sh:name "references" ;
        sh:order 14 ;
        sh:nodeKind sh:IRI ;
        sh:class khub:Entity ;
        khub:kind "any"
    ] ;
    sh:property [
        sh:path khub:depends_on ;
        sh:name "depends_on" ;
        sh:order 15 ;
        sh:nodeKind sh:IRI ;
        sh:class khub:Entity ;
        khub:kind "any" ;
        khub:acyclic true
    ] .

shape:client a sh:NodeShape ;
    sh:targetClass type:client ;
    sh:property [
        sh:path khub:draft ;
        sh:name "draft" ;
        sh:order 0 ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        khub:type "bool" ;
        khub:default false
    ] ;
    sh:property [
        sh:path khub:author ;
        sh:name "author" ;
        sh:order 1 ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        khub:type "text"
    ] ;
    sh:property [
        sh:path khub:created ;
        sh:name "created" ;
        sh:order 2 ;
        sh:or (
            [ sh:datatype xsd:date ]
            [ sh:datatype xsd:dateTime ]
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        khub:type "date"
    ] ;
    sh:property [
        sh:path khub:updated ;
        sh:name "updated" ;
        sh:order 3 ;
        sh:or (
            [ sh:datatype xsd:date ]
            [ sh:datatype xsd:dateTime ]
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        khub:type "date"
    ] ;
    sh:property [
        sh:path khub:title ;
        sh:name "title" ;
        sh:order 4 ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        khub:type "text"
    ] ;
    sh:property [
        sh:path khub:description ;
