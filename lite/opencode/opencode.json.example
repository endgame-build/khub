{
  "$schema": "https://opencode.ai/config.json",

  "// permission": [
    "Last matching rule wins, so the catch-all goes FIRST.",
    "opencode parses a shell line into sub-commands and asks per sub-command,",
    "so `bl check | head` needs `head *` allowed too — or just don't pipe.",
    "Use the `bl *` form if you symlinked bl onto PATH; keep the python3 form",
    "otherwise. Both are harmless to leave in."
  ],
  "permission": {
    "bash": {
      "*": "ask",
      "bl *": "allow",
      "python3 *bl.py *": "allow"
    }
  },

  "// instructions": [
    "Optional. A short knowledge/AGENTS.md is pulled in lazily when the agent",
    "reads a file under knowledge/, which costs nothing until the corpus is",
    "actually touched — usually better than listing it here."
  ],
  "instructions": []
}
