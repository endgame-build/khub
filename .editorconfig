# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.{yaml,yml,json,jsonl,js,mjs,sh}]
indent_style = space
indent_size = 2

[*.md]
# A trailing double space is a Markdown line break.
trim_trailing_whitespace = false

# Recorded bytes are the contract. An editor must not "fix" them.
[parity/cases/**/expected/**]
insert_final_newline = false
trim_trailing_whitespace = false

[parity/corpus/**]
insert_final_newline = false
trim_trailing_whitespace = false
